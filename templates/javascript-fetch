async function main() {
    const request = await fetch("{{ url }}", {
        method: "{{ method }}",
        {%- if let Some(body) = body %}
        body: `{{ body }}`,
        {%- endif %}
        {%- if !headers.is_empty() %}
        headers: {
            {%- for (key, val) in headers.iter() %}
            "{{ key }}": "{{ val }}",
            {%- endfor %}
        },
        {%- endif %}
    });
}

main();